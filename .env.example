# Copy to .env (gitignored) for local runs. In CI these live in GitHub Actions Secrets
# (ADR-001: secrets at rest in Actions Secrets, AES-256; no payment method on file with any vendor).
#
# PARSING RULE (macro_pipeline/_env.py): a line is `KEY=value`, the value is everything after the
# first `=`, and it is NOT comment-stripped. Never put a trailing `# comment` on a filled-in line,
# or the comment text becomes part of the value. Comments go on their own line, as below.
# A real environment variable always wins over this file (os.environ.setdefault), so CI secrets
# take precedence, and an empty value here behaves the same as an absent one.
#
# Only the Python pipeline reads this file. The PWA in public/ holds no secrets and reads no
# config at all. The Cloudflare Worker in cron-worker/ has its own separate secrets: set those
# with `wrangler secret put`, never here (see cron-worker/README.md).

# --- Data sources ---------------------------------------------------------------
# REQUIRED. Free, no card: https://fredaccount.stlouisfed.org/apikeys
# Absent: FredClient raises FredError. run_daily.py alerts, fail-pings, logs an audit row and
# exits nonzero WITHOUT overwriting public/briefing.json, so the PWA keeps the last-good card.
FRED_API_KEY=

# Optional. Unlocks gold-api.com's /history endpoint (~10y of daily gold prices) behind the
# gold_spot row. Free tier, no card, capped at 10 requests/hour.
# Absent: the row still publishes from the keyless live tick, current-value-only. Never an error.
GOLD_API_KEY=

# Optional. BLS "registration key" (free, no card): raises the daily query cap 25 -> 500.
# BlsSource grafts BLS's 08:30 ET release tip onto CPI / core CPI / unemployment / payrolls /
# participation / mfg + construction employment, so they read same-day from the primary publisher
# instead of FRED's ~10:10 ET mirror. Absent: the graft still runs unregistered (25/day is plenty
# for a twice-daily cron); the key just adds headroom. Never a hard failure either way.
# In requests it is sent as the `registrationkey` field, not a header.
BLS_API_KEY=

# --- LLM: Claude on Amazon Bedrock ------------------------------------------------
# REQUIRED for a real briefing. Writer = Claude Haiku 5.5, failover = Sonnet 5.5,
# judges = Sonnet 5.5 (failover Haiku 5.5). Absent: run_daily.py publishes the
# deterministic fallback card; run_briefing.py and run_judge.py exit 1.
# Use an IAM user limited to Bedrock inference (AmazonBedrockMantleInferenceAccess).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Model overrides. Unset = the defaults in llm_client.py. Set only to test another model.
CLAUDE_PRIMARY_MODEL=
CLAUDE_FAILOVER_MODEL=
CLAUDE_JUDGE_MODEL=
CLAUDE_JUDGE_FAILOVER_MODEL=

# --- Legacy providers (comparison only) ----------------------------------------------
# Read only by scripts/compare_models.py, which runs the same 12 requests through
# Gemini/Groq and Claude. The production pipeline never calls them.
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Alerting (all optional; unset = that signal is silently dead, never noisy) ---
# healthchecks.io, free tier, no card. Six checks, each bound to its own URL.
# Every ping is a pure no-op when its variable is unset: no request is built, nothing raises.
#
# The AM/PM cron dead-man switch. Pinged start/success/fail by every in-window firing.
HEALTHCHECKS_URL=
# Fails when a run published a fallback or refusal instead of a live LLM briefing.
# Needed because such a run still exits 0 and pings the dead-man switch green.
HEALTHCHECKS_URL_QUALITY=
# Fails when an indicator was blanked by the plausibility guard, or any-tier row went stale,
# or FRED was unreachable. Note: a source that degraded but still delivered no longer fails
# this check (changed 2026-08-14); it only appears in the Slack alert body.
HEALTHCHECKS_URL_SOURCES=
# Fails when the daily 3-dimension eval drops below its pass threshold (default 0.9).
HEALTHCHECKS_URL_JUDGE=
# Weekly ship-gate switch. Pinged success only on a PASS verdict; FAIL and INCONCLUSIVE both
# fail it. This is what pages when the gate stops running at all.
HEALTHCHECKS_URL_REGRESSION=
# Read-only healthchecks.io API key. Used by scripts/check_healthchecks.py to audit
# check status. Read-only: it cannot ping or edit checks.
HEALTHCHECKS_RO_KEY=

# Slack incoming webhook. Carries every human-facing alert: degraded run, crash, FRED down,
# monitoring RED, eval below threshold, regression verdicts.
# Absent: send_alert is a pure no-op, so all seven alert paths go quiet at once. The
# healthchecks emails still fire; the Slack channel does not.
ALERT_SLACK_WEBHOOK=

# --- Tracing (optional; LangSmith free Developer tier, 5k traces/month, no card) ---
# Absent: tracing.enabled() returns False and the whole layer no-ops. Also needs the optional
# SDK: pip install -e ".[langsmith]".
LANGSMITH_API_KEY=
# Kill switch. Unset means ON (when the key is set). "false"/"0"/"no"/"" mean OFF.
# Note the empty string counts as OFF, so `LANGSMITH_TRACING=` is not the same as omitting it.
LANGSMITH_TRACING=true
# Defaults to "macro-daily-briefing" in code; set only to override.
LANGSMITH_PROJECT=

# Optional free gov keys (no card): BEA unlocks the GDP release-morning graft,
# Census the housing-starts graft, EIA the energy series. Absent: no request is made;
# FRED values publish.
BEA_API_KEY=
CENSUS_API_KEY=
EIA_API_KEY=